# ===== 基础 =====
PORT=3000
# 数据目录(默认 ./data,相对仓库根)
DATA_DIR=./data
# 站点公开地址(用于凭证二维码 /verify 链接)
PUBLIC_BASE_URL=http://localhost:5173
# 前端请求的后端地址(留空 = 同源;EdgeOne Pages 等异地部署时填 https://<后端域名>,必须 https)
VITE_API_BASE=

# ===== 生成引擎 =====
# codex | mock(mock 模式无需安装 codex,3s 后返回内置示例页)
GENERATION_PROVIDER=mock
CODEX_BIN=codex
# 自定义接入(兼容中转/自建网关)。不配置则使用 codex 默认登录态
# 智谱 GLM Coding Plan 示例:
#   CODEX_BASE_URL=https://open.bigmodel.cn/api/v1
#   CODEX_MODEL_PROVIDER=zai
#   CODEX_MODEL=glm-5.3   (或 glm-5-turbo,更快)
#   CODEX_API_KEY=<你的 Coding Plan 专属 Key,与通用 API Key 不通用>
# 文档: https://docs.bigmodel.cn/cn/coding-plan/tool/codex
CODEX_BASE_URL=
CODEX_API_KEY=
CODEX_MODEL_PROVIDER=w2s
CODEX_MODEL=
# wire 协议:responses(默认)|chat(chat-only 端点如智谱 Coding Plan 必需;codex CLI 已在镜像钉 0.92)
CODEX_WIRE_API=
# codex 沙箱档位:workspace-write(默认)|read-only|danger-full-access(排障)
CODEX_SANDBOX=
# 模型上下文窗口(tokens):自定义 provider 的模型 codex 不认识,fallback 窗口过小会报
# "ran out of room in the model's context window";GLM 默认 131072
CODEX_CONTEXT_WINDOW=131072
# 本地 LLM 反代(llmProxy.ts):配置后容器内 127.0.0.1:3456 起代理,把 codex 的
# role:"developer" 改写成 system 再转发该内网上游(SSE 流式透传)。
# 用法:LLM_PROXY_UPSTREAM=http://<内网网关>:33000 + CODEX_BASE_URL=http://127.0.0.1:3456/v1
# (场景:自建网关上游不认 developer 角色,或出口网络拦 rustls 的 HTTPS 指纹只能走内网明文)
LLM_PROXY_UPSTREAM=
LLM_PROXY_PORT=3456

# 并发 codex 会话数
MAX_CONCURRENT=3
# 单次生成超时(毫秒)
GEN_TIMEOUT_MS=240000

# ===== 发布(sslly-nginx 网关 DeployStatic)=====
SSLLY_API_BASE=https://sslly-nas.hnrobert.space/api/v1
# 两步认证：长效 token 只能调 Authenticate 换 12h 会话，其余调用带会话 bearer（publisher 自动管理）
SSLLY_API_USER=admin
SSLLY_API_TOKEN=admin
DEPLOY_GROUP=hf
# 参与者域名模板,{label} 为自定义部分;必须含 {label};当前 *.unnc.space 通配证书可用
DEPLOY_DOMAIN_TEMPLATE={label}.unnc.space

# ===== 完成通知邮件(email-poster webhook,未配置则跳过发送)=====
MAIL_WEBHOOK_URL=
MAIL_FROM=noreply@words2site.local
MAIL_TOKEN=
# 注意:当前 webhook 为 custom_example 模式({email, subject, content}),用错模式会静默失败
MAIL_PRESET=custom_example

# ===== 管理 =====
ADMIN_PASSWORD=change-me
# 跨域放行来源(逗号分隔;配合 VITE_API_BASE 前端异地部署,如 Pages 域名;留空 = 仅同源)
ALLOWED_ORIGINS=
# 防刷:每 IP 每小时生成任务数
RATE_MAX_PER_HOUR=3
# 参与者文本长度限制
MAX_TEXT_LEN=300
