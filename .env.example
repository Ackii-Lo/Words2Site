# ===== 基础 =====
PORT=3000
# 数据目录(默认 ./data,相对仓库根)
DATA_DIR=./data
# 站点公开地址(用于凭证二维码 /verify 链接)
PUBLIC_BASE_URL=http://localhost:5173
# 前端请求的后端地址(留空 = 同源;EdgeOne Pages 等异地部署时填 https://<后端域名>,必须 https)
VITE_API_BASE=

# ===== 生成引擎 =====
# codex | mock(mock 模式无需安装 codex,3s 后返回内置示例页)
GENERATION_PROVIDER=mock
CODEX_BIN=codex
# 自定义接入(兼容中转/自建网关)。不配置则使用 codex 默认登录态
# 智谱 GLM Coding Plan 示例:
#   CODEX_BASE_URL=https://open.bigmodel.cn/api/v1
#   CODEX_MODEL_PROVIDER=zai
#   CODEX_MODEL=glm-5.3   (或 glm-5-turbo,更快)
#   CODEX_API_KEY=<你的 Coding Plan 专属 Key,与通用 API Key 不通用>
# 文档: https://docs.bigmodel.cn/cn/coding-plan/tool/codex
CODEX_BASE_URL=
CODEX_API_KEY=
CODEX_MODEL_PROVIDER=w2s
CODEX_MODEL=
# 并发 codex 会话数
MAX_CONCURRENT=3
# 单次生成超时(毫秒)
GEN_TIMEOUT_MS=240000
# 每任务最多 refine 次数
MAX_REFINE=2

# ===== 语音转写 =====
# openai-api | local | mock
WHISPER_PROVIDER=mock
OPENAI_API_KEY=
# OpenAI 兼容转写服务地址(默认官方;自建 Speaches 时填 http://whisper:8000/v1,model 用 HF 名如 Systran/faster-whisper-small)
OPENAI_BASE_URL=
OPENAI_TRANSCRIBE_MODEL=whisper-1
# local 模式的 whisper 命令(Python openai-whisper 或 whisper.cpp main)
LOCAL_WHISPER_CMD=whisper

# ===== 发布(sslly-nginx 网关 DeployStatic)=====
SSLLY_API_BASE=https://sslly-nas.hnrobert.space/api/v1
SSLLY_API_TOKEN=admin
DEPLOY_GROUP=hf
# 参与者域名模板,{label} 为自定义部分;必须含 {label};当前 *.unnc.space 通配证书可用
DEPLOY_DOMAIN_TEMPLATE={label}.unnc.space

# ===== 完成通知邮件(email-poster webhook,未配置则跳过发送)=====
MAIL_WEBHOOK_URL=
MAIL_FROM=noreply@words2site.local
MAIL_TOKEN=
# 注意:当前 webhook 为 custom_example 模式({email, subject, content}),用错模式会静默失败
MAIL_PRESET=custom_example

# ===== 管理 =====
ADMIN_PASSWORD=change-me
# 跨域放行来源(逗号分隔;配合 VITE_API_BASE 前端异地部署,如 Pages 域名;留空 = 仅同源)
ALLOWED_ORIGINS=
# 防刷:每 IP 每小时生成任务数
RATE_MAX_PER_HOUR=3
RATE_TRANSCRIBE_PER_HOUR=10
# 参与者文本长度限制
MAX_TEXT_LEN=300
